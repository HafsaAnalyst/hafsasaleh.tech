---
import { site } from '../site';

const year = new Date().getFullYear();

const links = [
  { href: site.socials.github, label: 'GitHub' },
  { href: site.socials.linkedin, label: 'LinkedIn' },
  { href: site.socials.x, label: 'X' },
  { href: site.socials.kaggle, label: 'Kaggle' },
  { href: site.socials.scholar, label: 'Scholar' },
  { href: `mailto:${site.email}`, label: 'Email' },
  { href: '/rss.xml', label: 'RSS' },
].filter((l) => Boolean(l.href));
---

<footer class="site-footer">
  <div class="wrap">
    <p>&copy; {year} {site.name}. Built with Astro.</p>
    <div class="social">
      {links.map((l) => (
        <a href={l.href} rel={l.href.startsWith('http') ? 'me noopener' : undefined}>{l.label}</a>
      ))}
    </div>
  </div>
</footer>
