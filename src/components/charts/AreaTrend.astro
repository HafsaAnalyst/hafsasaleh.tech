---
// Stacked area, change-over-time by source. Legend + direct end-labels (≤4
// series), so identity is never colour-alone. Boundaries get a 2px surface
// separator rather than a border around each band.
interface Series {
  name: string;
  /** CSS custom property name from the validated categorical order */
  colour: string;
  values: number[];
}

interface Props {
  series: Series[];
  labels: string[];
  /** Show every Nth x tick */
  tickEvery?: number;
  yLabel?: string;
}

const { series, labels, tickEvery = 6, yLabel = '' } = Astro.props;

const W = 660;
const H = 240;
// right gutter sized for the longest end-label (~6px/char at 11px) + swatch + gaps
const PAD = { top: 12, right: 112, bottom: 26, left: 34 };
const plotW = W - PAD.left - PAD.right;
const plotH = H - PAD.top - PAD.bottom;

const n = labels.length;
// Cumulative stack, series[0] at the bottom
const stacks: number[][] = [];
let running = new Array(n).fill(0);
for (const s of series) {
  running = running.map((v, i) => v + s.values[i]);
  stacks.push([...running]);
}
const yMax = Math.ceil(Math.max(...running) / 20) * 20;

const x = (i: number) => PAD.left + (i / (n - 1)) * plotW;
const y = (v: number) => PAD.top + plotH - (v / yMax) * plotH;

const bandPath = (upper: number[], lower: number[]) => {
  const up = upper.map((v, i) => `${i === 0 ? 'M' : 'L'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join('');
  const down = [...lower]
    .map((v, i) => ({ v, i }))
    .reverse()
    .map(({ v, i }) => `L${x(i).toFixed(1)},${y(v).toFixed(1)}`)
    .join('');
  return `${up}${down}Z`;
};

const zero = new Array(n).fill(0);
const bands = series.map((s, si) => ({
  ...s,
  d: bandPath(stacks[si], si === 0 ? zero : stacks[si - 1]),
  // midpoint of the band at the last x, for the direct label
  labelY: y((stacks[si][n - 1] + (si === 0 ? 0 : stacks[si - 1][n - 1])) / 2),
}));

// Dodge end-labels so they never collide
const MIN_GAP = 15;
const ordered = [...bands].sort((a, b) => a.labelY - b.labelY);
for (let i = 1; i < ordered.length; i++) {
  if (ordered[i].labelY - ordered[i - 1].labelY < MIN_GAP) {
    ordered[i].labelY = ordered[i - 1].labelY + MIN_GAP;
  }
}

const gridVals = [0, yMax / 2, yMax];
const totals = series.map((s) => s.values.reduce((a, b) => a + b, 0));
---

<div class="legend">
  {series.map((s) => (
    <span class="legend-item">
      <span class="legend-swatch" style={`background:var(${s.colour})`}></span>{s.name}
    </span>
  ))}
</div>

<svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Stacked area chart of ${series.map((s) => s.name).join(', ')} over time`}>
  {gridVals.map((v) => (
    <>
      <line class="grid-line" x1={PAD.left} x2={PAD.left + plotW} y1={y(v)} y2={y(v)} />
      <text class="axis-text" x={PAD.left - 7} y={y(v) + 3} text-anchor="end">{v}</text>
    </>
  ))}

  {bands.map((b) => (
    <path class="area-band" d={b.d} fill={`var(${b.colour})`} fill-opacity="0.9">
      <title>{b.name}</title>
    </path>
  ))}

  {/* 2px surface separators between stacked fills */}
  {stacks.slice(0, -1).map((s) => (
    <path
      d={s.map((v, i) => `${i === 0 ? 'M' : 'L'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join('')}
      fill="none"
      stroke="var(--viz-surface)"
      stroke-width="2"
    />
  ))}

  <line class="axis-line" x1={PAD.left} x2={PAD.left + plotW} y1={y(0)} y2={y(0)} />

  {labels.map((l, i) =>
    i % tickEvery === 0 ? (
      <text class="axis-text" x={x(i)} y={H - 8} text-anchor="middle">{l}</text>
    ) : null
  )}

  {ordered.map((b) => (
    <>
      <rect x={PAD.left + plotW + 8} y={b.labelY - 4} width="8" height="8" rx="2" fill={`var(${b.colour})`} />
      <text class="series-label" x={PAD.left + plotW + 21} y={b.labelY + 4}>{b.name}</text>
    </>
  ))}

  {yLabel && <text class="axis-text" x={PAD.left} y={PAD.top - 2} text-anchor="start">{yLabel}</text>}
</svg>

<details class="viz-table">
  <summary>View as table</summary>
  <table>
    <thead>
      <tr><th>Source</th><th>Total over period</th><th>Share</th></tr>
    </thead>
    <tbody>
      {series.map((s, i) => (
        <tr>
          <td>{s.name}</td>
          <td>{totals[i]}</td>
          <td>{Math.round((totals[i] / totals.reduce((a, b) => a + b, 0)) * 100)}%</td>
        </tr>
      ))}
    </tbody>
  </table>
</details>
