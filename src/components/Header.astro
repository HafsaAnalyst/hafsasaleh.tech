---
import { site, nav } from '../site';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">{site.name.split(' ')[0]}<span>{site.name.split(' ').slice(1).join(' ') ? ' ' + site.name.split(' ').slice(1).join(' ') : ''}</span></a>
    <nav class="nav" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
      <a class="hire" href="/contact/">HIRE ME</a>
    </nav>
  </div>
</header>

<style>
  .hire {
    background: var(--accent);
    color: var(--paper) !important;
    font-weight: 700;
    font-size: .78rem;
    letter-spacing: .06em;
    padding: .45rem 1rem !important;
    border-radius: 999px !important;
    margin-left: .4rem;
    box-shadow: 0 6px 22px -8px var(--accent);
    transition: transform .15s, filter .15s;
  }
  .hire:hover { transform: translateY(-1px); filter: brightness(1.1); background: var(--accent) !important; }
</style>
