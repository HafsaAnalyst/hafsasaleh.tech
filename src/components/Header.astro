---
import { site, nav } from '../site';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/">
      <img class="avatar" src="/hafsa-saleh-square.jpg" width="760" height="760" alt="" />{site.name.split(' ')[0]}<span>{site.name.split(' ').slice(1).join(' ') ? ' ' + site.name.split(' ').slice(1).join(' ') : ''}</span></a>
    <nav class="nav" aria-label="Main">
      {nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}

      <button id="theme-toggle" class="theme-btn" type="button" aria-label="Switch theme" title="Switch theme">
        <svg class="i-sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" fill="currentColor" />
          <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M12 2.4v2.2M12 19.4v2.2M2.4 12h2.2M19.4 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6" />
          </g>
        </svg>
        <svg class="i-moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
          <path d="M20 14.5A8.2 8.2 0 019.6 4a8.5 8.5 0 102.9 16.5A8.2 8.2 0 0120 14.5z" fill="currentColor" />
        </svg>
      </button>

      <a class="hire" href="/contact/">HIRE ME</a>
    </nav>
  </div>
</header>

<style>
  .brand { display: inline-flex; align-items: center; gap: .6rem; }
  .avatar {
    width: 30px; height: 30px; border-radius: 50%;
    object-fit: cover; object-position: 50% 28%;
    border: 1px solid var(--line); flex: none;
  }

  .theme-btn {
    display: inline-grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    margin-left: .35rem;
    padding: 0;
    cursor: pointer;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    transition: color .15s, border-color .15s, background .15s;
  }
  .theme-btn:hover { color: var(--accent); border-color: var(--accent); background: var(--surface-2); }
  .theme-btn svg { grid-area: 1 / 1; }

  /* Show the icon for the theme you'd switch TO, so the control reads as an action */
  .i-sun { display: none; }
  .i-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .i-sun { display: block; }
    :root:not([data-theme="light"]) .i-moon { display: none; }
  }
  :root[data-theme="dark"] .i-sun { display: block; }
  :root[data-theme="dark"] .i-moon { display: none; }
  :root[data-theme="light"] .i-sun { display: none; }
  :root[data-theme="light"] .i-moon { display: block; }

  .hire {
    background: var(--accent);
    color: var(--paper) !important;
    font-weight: 700;
    font-size: .78rem;
    letter-spacing: .06em;
    padding: .45rem 1rem !important;
    border-radius: 999px !important;
    margin-left: .4rem;
    box-shadow: 0 6px 22px -8px var(--accent);
    transition: transform .15s, filter .15s;
  }
  .hire:hover { transform: translateY(-1px); filter: brightness(1.1); background: var(--accent) !important; }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    // Whatever is on screen right now — whether it came from a stamp or the OS
    const showing =
      root.dataset.theme ??
      (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = showing === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
</script>
