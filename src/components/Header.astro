---
import { site, nav } from '../site';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class="site-header">
  <div class="topbar-inner">
    <a class="brand" href="/">
      <img src="/favicon.svg" alt="" width="34" height="34" />
      {site.name}
    </a>

    <div class="top-right">
      <nav class="nav" aria-label="Main">
        {nav.map((item) => (
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))}
      </nav>

      <button id="theme-toggle" class="theme-btn" type="button" aria-label="Switch theme" title="Switch theme">
        <svg class="i-sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" fill="currentColor" />
          <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M12 2.4v2.2M12 19.4v2.2M2.4 12h2.2M19.4 12h2.2M5.2 5.2l1.6 1.6M17.2 17.2l1.6 1.6M18.8 5.2l-1.6 1.6M6.8 17.2l-1.6 1.6" />
          </g>
        </svg>
        <svg class="i-moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
          <path d="M20 14.5A8.2 8.2 0 019.6 4a8.5 8.5 0 102.9 16.5A8.2 8.2 0 0120 14.5z" fill="currentColor" />
        </svg>
      </button>

      <a class="btn btn-primary btn-sm hire" href={site.booking} rel="noopener">Book a reporting check</a>
    </div>
  </div>
</header>

<style>
  .theme-btn {
    display: inline-grid; place-items: center;
    width: 32px; height: 32px; padding: 0;
    cursor: pointer; color: var(--faint);
    background: transparent; border: 1px solid var(--line); border-radius: 999px;
  }
  .theme-btn:hover { color: var(--accent); border-color: var(--accent); }
  .theme-btn svg { grid-area: 1 / 1; }

  /* Show the icon for the theme you'd switch TO, so the control reads as an action */
  .i-sun { display: none; }
  .i-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .i-sun { display: block; }
    :root:not([data-theme="light"]) .i-moon { display: none; }
  }
  :root[data-theme="dark"] .i-sun { display: block; }
  :root[data-theme="dark"] .i-moon { display: none; }
  :root[data-theme="light"] .i-sun { display: none; }
  :root[data-theme="light"] .i-moon { display: block; }

  .hire { margin-left: 6px; white-space: nowrap; }

  /* Phones: brand, toggle and button on the first line, nav links on the second */
  @media (max-width: 640px) {
    .topbar-inner { flex-wrap: wrap; padding-block: 12px; row-gap: 6px; }
    .brand { font-size: 0; gap: 0; }
    .top-right { display: contents; }
    .theme-btn { margin-left: auto; }
    .nav { order: 3; width: 100%; margin-left: -8px; }
    .hire { padding: 9px 12px; font-size: 13px; }
  }
</style>

<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    // Whatever is on screen right now — whether it came from a stamp or the OS
    const showing =
      root.dataset.theme ??
      (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = showing === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
</script>
