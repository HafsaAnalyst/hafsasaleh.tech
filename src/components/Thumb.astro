---
// Row thumbnail: a small 200×117 sketch in place of a photo. Drawn as SVG so it
// scales cleanly from 200px down to the 100px mobile size, and reads tokens so
// it follows the theme. Sketches are decorative; text thumbs carry real content.
interface Props {
  kind: 'sheet' | 'bars' | 'funnel' | 'dashboard' | 'report' | 'alert' | 'text';
  /** For kind="text": the figure or numeral to show */
  value?: string;
  /** For kind="text": smaller line under the value */
  sub?: string;
}
const { kind, value = '', sub } = Astro.props;
const size = value.length <= 3 ? 46 : value.length <= 8 ? 30 : 24;
---

<div class="thumb" aria-hidden={kind !== 'text' ? 'true' : undefined}>
  <svg viewBox="0 0 200 117" role={kind === 'text' ? 'img' : undefined} aria-label={kind === 'text' ? [value, sub].filter(Boolean).join(', ') : undefined}>
    {kind === 'sheet' && (
      <g>
        {[0, 1, 2, 3, 4].map((r) => <line class="ln" x1="30" x2="170" y1={24 + r * 17} y2={24 + r * 17} />)}
        {[0, 1, 2, 3].map((c) => <line class="ln" x1={30 + c * 46.6} x2={30 + c * 46.6} y1="24" y2="92" />)}
        <line class="ln" x1="170" x2="170" y1="24" y2="92" />
        <rect class="soft" x="30" y="24" width="140" height="17" />
        <rect class="acc" x="125" y="58" width="44" height="16" opacity=".55" />
        <text class="mark" x="147" y="70.5" text-anchor="middle">#REF!</text>
      </g>
    )}
    {kind === 'bars' && (
      <g>
        <line class="ln" x1="30" x2="170" y1="96" y2="96" />
        <rect class="acc" x="40" y="52" width="22" height="44" rx="2" />
        <rect class="acc" x="74" y="34" width="22" height="62" rx="2" opacity=".75" />
        <rect class="dash" x="108" y="24" width="22" height="72" rx="2" />
        <rect class="acc" x="142" y="64" width="22" height="32" rx="2" opacity=".5" />
        <text class="q" x="119" y="66" text-anchor="middle">?</text>
      </g>
    )}
    {kind === 'funnel' && (
      <g>
        <rect class="acc" x="30" y="18" width="140" height="16" rx="3" />
        <rect class="acc" x="44" y="42" width="112" height="16" rx="3" opacity=".75" />
        <rect class="acc" x="62" y="66" width="76" height="16" rx="3" opacity=".55" />
        <rect class="acc" x="80" y="90" width="40" height="16" rx="3" opacity=".35" />
        <circle class="drip" cx="168" cy="50" r="3" /><circle class="drip" cx="150" cy="76" r="3" /><circle class="drip" cx="132" cy="100" r="3" />
      </g>
    )}
    {kind === 'dashboard' && (
      <g>
        <rect class="tile" x="22" y="16" width="48" height="26" rx="4" />
        <rect class="tile" x="76" y="16" width="48" height="26" rx="4" />
        <rect class="tile" x="130" y="16" width="48" height="26" rx="4" />
        <rect class="acc" x="28" y="30" width="24" height="5" rx="2" />
        <rect class="acc" x="82" y="30" width="30" height="5" rx="2" />
        <rect class="acc" x="136" y="30" width="18" height="5" rx="2" />
        <rect class="tile" x="22" y="50" width="156" height="52" rx="4" />
        <polyline class="line" points="30,92 52,82 74,86 96,70 118,74 140,60 170,58" />
      </g>
    )}
    {kind === 'report' && (
      <g>
        <rect class="tile" x="58" y="10" width="84" height="98" rx="5" />
        <text class="mon" x="100" y="30" text-anchor="middle">MONDAY</text>
        <line class="ln" x1="70" x2="130" y1="40" y2="40" />
        <rect class="acc" x="72" y="74" width="10" height="22" rx="1" opacity=".55" />
        <rect class="acc" x="88" y="62" width="10" height="34" rx="1" opacity=".75" />
        <rect class="acc" x="104" y="54" width="10" height="42" rx="1" />
        <rect class="acc" x="120" y="66" width="10" height="30" rx="1" opacity=".65" />
      </g>
    )}
    {kind === 'alert' && (
      <g>
        <line class="ln" x1="22" x2="178" y1="62" y2="62" />
        {[34, 62, 90, 118].map((x) => <circle class="dot" cx={x} cy="62" r="5" />)}
        <circle class="ring" cx="152" cy="62" r="13" />
        <circle class="acc" cx="152" cy="62" r="6" />
        <text class="mark" x="152" y="96" text-anchor="middle">gone quiet</text>
      </g>
    )}
    {kind === 'text' && (
      <g>
        <text class="val" x="100" y={sub ? 62 : 70} text-anchor="middle" font-size={size}>{value}</text>
        {sub && <text class="sub" x="100" y="88" text-anchor="middle">{sub}</text>}
      </g>
    )}
  </svg>
</div>

<style>
  .thumb {
    width: 100%; aspect-ratio: 200 / 117;
    border: 1px solid var(--line); border-radius: 8px;
    background: var(--surface-2); overflow: hidden;
  }
  svg { width: 100%; height: 100%; }
  .ln { stroke: var(--card-line); stroke-width: 1.5; }
  .soft { fill: var(--accent-tint); }
  .acc { fill: var(--accent); }
  .dash { fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 4 3; }
  .drip { fill: var(--accent); opacity: .45; }
  .tile { fill: var(--paper); stroke: var(--card-line); stroke-width: 1.2; }
  .line { fill: none; stroke: var(--accent); stroke-width: 2.5; stroke-linecap: round; stroke-linejoin: round; }
  .dot { fill: var(--card-line); }
  .ring { fill: none; stroke: var(--accent); stroke-width: 2; opacity: .6; }
  .q { font: 700 22px var(--font-display); fill: var(--accent-ink); }
  .mark { font: 700 10px var(--font-body); fill: var(--faint); letter-spacing: .5px; }
  .mon { font: 700 9px var(--font-body); fill: var(--faint); letter-spacing: 1.5px; }
  .val { font-family: var(--font-display); font-weight: 700; fill: var(--accent-ink); letter-spacing: -.5px; }
  .sub { font: 400 11px var(--font-body); fill: var(--faint); letter-spacing: 1px; text-transform: uppercase; }
</style>
