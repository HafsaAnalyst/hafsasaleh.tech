---
import type { Project } from '../data/projects';
import { kindLabel } from '../data/projects';
import ProjectCover from './ProjectCover.astro';

interface Props { project: Project }
const { project } = Astro.props;
---

<article class:list={['card', project.href && 'card-link']}>
  {project.cover && <ProjectCover variant={project.cover} alt={`Cover illustration for ${project.title}`} />}
  <span class="meta">{kindLabel[project.kind]} · {project.year}</span>
  <h3>
    {/* This anchor is stretched over the whole card by CSS, so the entire card
        is one click target. Anchors cannot be nested, which is why the external
        links below sit above it on z-index rather than being wrapped. */}
    {project.href ? <a class="stretch" href={project.href}>{project.title}</a> : project.title}
  </h3>
  {project.org && <p class="org">{project.org}</p>}
  <p>{project.summary}</p>
  {project.outcome && <p class="outcome">{project.outcome}</p>}

  <div class="links-row">
    {project.href && <span class="go">Read the case study →</span>}
    {project.links?.map((l) => (
      <a class="above" href={l.href} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label} →</a>
    ))}
  </div>

  <div class="tags">
    {project.tags.map((t) => <span class="tag">{t}</span>)}
  </div>
</article>

<style>
  .card-link { position: relative; cursor: pointer; }
  .card-link .stretch { text-decoration: none; }
  .card-link .stretch::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  /* keep the real links above the stretched overlay so they still work */
  .card-link .above { position: relative; z-index: 1; }

  .card-link:hover h3 { color: var(--accent); }
  .go { color: var(--accent); font-weight: 500; }

  .org { color: var(--muted); font-size: .85rem; margin-top: -.35rem; }
  .outcome { color: var(--accent); font-weight: 500; font-size: .9rem; }
</style>
