---
import type { Project } from '../data/projects';
import { kindLabel } from '../data/projects';

interface Props { project: Project }
const { project } = Astro.props;
---

<article class="card">
  <span class="meta">{kindLabel[project.kind]} · {project.year}</span>
  <h3>
    {project.href ? <a href={project.href}>{project.title}</a> : project.title}
  </h3>
  {project.org && <p style="color:var(--muted); font-size:.85rem; margin-top:-.35rem;">{project.org}</p>}
  <p>{project.summary}</p>
  {project.outcome && (
    <p style="color: var(--accent); font-weight: 500; font-size: .9rem;">{project.outcome}</p>
  )}
  <div class="links-row">
    {project.href && <a href={project.href}>Read the case study →</a>}
    {project.links?.map((l) => (
      <a href={l.href} rel={l.href.startsWith('http') ? 'noopener' : undefined}>{l.label} →</a>
    ))}
  </div>
  <div class="tags">
    {project.tags.map((t) => <span class="tag">{t}</span>)}
  </div>
</article>
