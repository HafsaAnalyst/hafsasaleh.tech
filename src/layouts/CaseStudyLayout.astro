---
import BaseLayout from './BaseLayout.astro';
import CtaCard from '../components/CtaCard.astro';
import '../styles/charts.css';

interface Props {
  title: string;
  /** Small uppercase line above the title, e.g. "IMPACT STORY · ANALYTICS → REVENUE" */
  eyebrow: string;
  /** One sentence under the title */
  hook: string;
  description: string;
  org?: string;
  year?: string;
  stack?: string[];
}

const { title, eyebrow, hook, description, org, year, stack = [] } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <article class="index">
    <header class="index-header">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="intro">{hook}</p>
      {(org || year) && (
        <p class="date" style="margin-top:14px;">{[org, year].filter(Boolean).join(' · ')}</p>
      )}
      {stack.length > 0 && (
        <div class="tags" style="margin-top:20px;">
          {stack.map((s) => <span class="tag">{s}</span>)}
        </div>
      )}
    </header>

    <div class="cs-body">
      <slot />
    </div>

    <CtaCard
      heading="Want this kind of clarity for your recruitment pipeline?"
      text="The same approach, applied to CVs sent, interviews, offers and placements. Start with a free 20-minute reporting check."
    />
    <p class="back"><a class="text-link" href="/recruitment-agencies/">What I build for recruitment agencies →</a></p>
  </article>
</BaseLayout>

<style>
  .cs-body { border-top: 1px solid var(--line); padding-top: 40px; margin-top: 30px; }
  .back { text-align: center; margin-top: 24px; }
</style>
