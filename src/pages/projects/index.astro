---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';

const withStudy = projects.filter((p) => p.href);
const rest = projects.filter((p) => !p.href);
---

<BaseLayout
  title="Projects"
  description="Project catalog — marketing intelligence platforms, CRM architecture, funnel analytics and predictive models by Hafsa Saleh."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Catalog</p>
      <h1>Projects</h1>
      <p class="lead" style="margin-top:1rem; max-width:42rem;">
        Each project states the problem, what I built, and what changed as a result.
        The four below have full case studies with the numbers behind them.
      </p>

      <div class="grid grid-2" style="margin-top:2.5rem;">
        {withStudy.map((p) => <ProjectCard project={p} />)}
      </div>

      <h2 style="margin-top:4rem;">Also built</h2>
      <div class="grid grid-2" style="margin-top:1.8rem;">
        {rest.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>
</BaseLayout>
