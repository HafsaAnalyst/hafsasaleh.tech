---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';

const withStudy = projects.filter((p) => p.href);
const rest = projects.filter((p) => !p.href);
---

<BaseLayout
  title="Projects"
  description="Project catalog — marketing intelligence platforms, CRM architecture, funnel analytics and predictive models by Hafsa Saleh."
>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">Project catalog</p>
      <h1>Work that moved a number</h1>
      <p class="lead" style="margin-top:1rem; max-width:42rem;">
        Pipelines, attribution platforms, dashboards and models — each one stating the
        problem, what I built, and what changed as a result. The four below have full
        case studies with the evidence behind them.
      </p>

      <h2 class="cat-head">Case studies</h2>
      <div class="grid grid-2" style="margin-top:1.6rem;">
        {withStudy.map((p) => <ProjectCard project={p} />)}
      </div>

      <h2 class="cat-head" style="margin-top:4rem;">Also built</h2>
      <p style="color:var(--muted); font-size:.92rem; margin-top:.4rem;">
        Shipped and in use, without a long write-up.
      </p>
      <div class="grid grid-2" style="margin-top:1.6rem;">
        {rest.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .cat-head {
    margin-top: 3.5rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
    font-size: 1.35rem;
  }
</style>
