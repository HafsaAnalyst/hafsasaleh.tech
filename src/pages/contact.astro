---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';

const channels = [
  { label: 'Email', value: site.email, href: `mailto:${site.email}` },
  { label: 'LinkedIn', value: 'Connect with me', href: site.socials.linkedin },
  { label: 'GitHub', value: 'See my code', href: site.socials.github },
].filter((c) => Boolean(c.href));
---

<BaseLayout title="Contact" description={`Get in touch with ${site.name}.`}>
  <section class="section">
    <div class="wrap prose-wrap">
      <p class="eyebrow">Contact</p>
      <h1>Let's talk</h1>
      <p class="lead" style="margin-top:1rem;">
        Open to data science roles, consulting work and collaborations. The fastest way
        to reach me is email — I reply to everything that isn't a cold sales pitch.
      </p>

      <div class="grid grid-2" style="margin-top:2.5rem;">
        {channels.map((c) => (
          <a class="card" href={c.href} style="text-decoration:none;" rel={c.href.startsWith('http') ? 'noopener' : undefined}>
            <span class="meta">{c.label}</span>
            <h3 style="color:var(--accent);">{c.value}</h3>
          </a>
        ))}
      </div>

      <p style="margin-top:2.5rem; color:var(--muted); font-size:.9rem;">
        Based in {site.location}.
      </p>
    </div>
  </section>
</BaseLayout>
