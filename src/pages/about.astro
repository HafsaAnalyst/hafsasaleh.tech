---
import BaseLayout from '../layouts/BaseLayout.astro';
import Row from '../components/Row.astro';
import Thumb from '../components/Thumb.astro';
import CtaCard from '../components/CtaCard.astro';
import { site } from '../site';
import { builds } from '../data/recruitment';

const services = [
  { thumb: 'dashboard', t: 'Owner dashboard', d: 'Billings, placements, recruiter performance and pipeline conversion in one live view.' },
  { thumb: 'report', t: 'Automated weekly report', d: 'Delivered every Monday, with no manual exports.' },
  { thumb: 'alert', t: 'Follow-up automations', d: "Reminders and alerts so candidates and clients don't go quiet." },
] satisfies { thumb: (typeof builds)[number]['thumb']; t: string; d: string }[];

const steps = [
  { t: 'Listen first', d: 'A 20-minute call about how you report today.' },
  { t: 'Check the data', d: "Find out what's in your ATS and spreadsheets, and what can be trusted." },
  { t: 'Build fast', d: 'I use Python, Streamlit and AI-assisted development to ship in days, not months.' },
  { t: 'Validate', d: 'Check the numbers against what you already know.' },
  { t: 'Hand over', d: 'Your report runs on its own, and your team knows how to use it.' },
];

const expect = [
  'I work inside your accounts with counts and pipeline data, not candidate CVs.',
  "I'll tell you when a number can't be trusted rather than give you a confident wrong answer.",
  "I'm based in Lahore (UTC+5), which overlaps with UK afternoons and Australian mornings. US calls are in my evening.",
];

const facts = [
  'BSc (Honours) Statistics, University of the Punjab',
  'Published in Acta Geophysica (Springer, 2025)',
  'Tools: Python, SQL, Streamlit, Power BI, GA4, Claude Code',
  'In progress: IBM Generative AI and IBM AI-Native Data Engineer certificates (Coursera)',
];
---

<BaseLayout
  title="About"
  description="Hafsa Saleh is a statistics-trained data analyst who builds live dashboards and automated reports for small recruitment agencies, so owners can see which recruiters, clients and candidates turn into placements and fees."
>
  <div class="index">
    <header class="index-header">
      <p class="eyebrow">About</p>
      <h1>I help recruitment agency owners see where their money comes from.</h1>
      <p class="intro">
        I'm Hafsa, a data analyst with a statistics degree and a habit of asking "can we trust
        this number?" before anyone acts on it. I build live dashboards and automated reports for
        small recruitment agencies, so owners can see which recruiters, clients and candidates
        turn into placements and fees, without rebuilding numbers in Excel every Monday.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={site.booking} rel="noopener">Book a reporting check</a>
      </div>
    </header>

    <section class="section">
      <h2>My story</h2>
      <div class="prose story">
        <p>
          I started at Sapphire Finishing Mills as a Management Trainee Officer, working as a data
          analyst on reporting and forecasting from SAP data. That's where I learned that a number
          is only useful if someone trusts it enough to act on it. One recurring report there took
          an hour to build by hand; I automated it down to 14 seconds.
        </p>
        <p>
          Since 2022 I've also worked as a freelance analyst for research clients, and I've
          published a regression model on air quality in
          <a href="https://rdcu.be/eF8VH" rel="noopener"><em>Acta Geophysica</em></a>.
        </p>
        <p>
          Today I'm a Marketing Intelligence Analyst at an Australian migration consultancy. I
          track thousands of people through a long pipeline, from first enquiry to booked
          consultation to final outcome. By fixing how outcomes were recorded, I helped lift the
          consultation show rate from <a href="/projects/show-rate-recovery/">68% to 82%</a> with
          no extra ad spend.
        </p>
        <p>
          Recruitment works the same way: CVs sent, interviews, offers, placements. Most agencies
          already hold the data in their ATS but can't get a straight answer out of it.
          <strong>That's the gap I close.</strong>
        </p>
      </div>
    </section>

    <section class="section">
      <h2>What I do for recruitment agencies</h2>
      <ul class="rows">
        {services.map((s) => (
          <Row label="What you get" title={s.t} text={s.d} href="/recruitment-agencies/">
            <Thumb slot="thumb" kind={s.thumb} />
          </Row>
        ))}
      </ul>
    </section>

    <section class="section">
      <h2>How I work</h2>
      <ul class="rows compact">
        {steps.map((s, i) => (
          <Row label={`Step ${i + 1}`} title={s.t} text={s.d}>
            <Thumb slot="thumb" kind="text" value={String(i + 1).padStart(2, '0')} />
          </Row>
        ))}
      </ul>
    </section>

    <section class="section">
      <h2>What you can expect from me</h2>
      <ul class="ticks">
        {expect.map((e) => <li>{e}</li>)}
      </ul>
    </section>

    <section class="section">
      <h2>Quick facts</h2>
      <ul class="facts">
        {facts.map((f) => <li>{f}</li>)}
      </ul>
    </section>

    <CtaCard
      heading="If your weekly reporting takes more than an hour, let's talk."
      button="Book a free 20-minute reporting check"
    />
  </div>
</BaseLayout>

<style>
  .story { margin-top: 20px; color: var(--ink); }
  .story strong { font-weight: 700; }

  .ticks, .facts { list-style: none; padding: 0; margin-top: 24px; border-top: 1px solid var(--line); }
  .ticks li, .facts li {
    position: relative; padding: 18px 0 18px 30px;
    border-bottom: 1px solid var(--line); color: var(--ink);
  }
  .ticks li::before {
    content: '✓'; position: absolute; left: 2px; top: 18px;
    color: var(--accent-ink); font-weight: 700;
  }
  .facts li::before {
    content: ''; position: absolute; left: 4px; top: 29px;
    width: 7px; height: 7px; border-radius: 50%; background: var(--accent);
  }
</style>
