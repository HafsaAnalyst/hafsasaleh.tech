---
import BaseLayout from '../layouts/BaseLayout.astro';
import SampleDashboard from '../components/SampleDashboard.astro';
import Row from '../components/Row.astro';
import Thumb from '../components/Thumb.astro';
import CtaCard from '../components/CtaCard.astro';
import { site } from '../site';
import { builds, metrics, packages, privacy, faq, steps, TBC } from '../data/recruitment';
---

<BaseLayout
  fullTitle="Dashboards for Recruitment Agencies: Billings, Pipeline & Recruiter Performance"
  description="Recruitment agency dashboards and staffing agency reporting automation: billings per recruiter, CV sent to placement conversion, fill rate and fall-offs, built from your ATS data."
>
  <div class="index">
    <!-- ============ HEADER ============ -->
    <header class="index-header">
      <p class="eyebrow">For recruitment &amp; staffing agency owners</p>
      <h1>Know which recruiters, clients and candidates actually make you money.</h1>
      <p class="intro">
        Your ATS already holds the answers. I turn it into a live owner dashboard and an
        automated Monday report, so you can see billings, recruiter performance and where
        placements leak, without anyone rebuilding numbers in Excel.
      </p>
      <p class="fit">
        Built for perm and contract agencies with 2 to 20 recruiters, in Australia, the UK and
        the US. Works with data from tools like JobAdder and Bullhorn (via exports or API).
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={site.booking} rel="noopener">Book a free 20-minute reporting check</a>
        <a class="text-link" href="#pricing">See the packages →</a>
      </div>
    </header>

    <ul class="rows">
      {builds.map((b) => (
        <Row label="What you get" title={b.t} text={b.d}>
          <Thumb slot="thumb" kind={b.thumb} />
        </Row>
      ))}
    </ul>

    <!-- ============ METRICS ============ -->
    <section class="section">
      <h2>The recruitment KPIs I put in front of owners</h2>
      <p class="section-intro">Six numbers that answer the questions owners actually ask on a Monday.</p>
      <div class="table-wrap">
        <table class="kpis">
          <thead>
            <tr><th scope="col">Metric</th><th scope="col">What it tells you</th></tr>
          </thead>
          <tbody>
            {metrics.map((r) => (
              <tr><td>{r.m}</td><td>{r.w}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- ============ DEMO ============ -->
    <section class="section" id="demo">
      <h2>Sample dashboard</h2>
      <p class="section-intro">
        What an owner dashboard looks like: headline numbers up top, the pipeline from CV sent
        to placement below, and a breakdown by recruiter and client behind each one.
      </p>
      <SampleDashboard />
    </section>

    <!-- ============ HOW IT WORKS ============ -->
    <section class="section">
      <h2>How it works</h2>
      <ul class="rows compact">
        {steps.map((s) => (
          <Row label={`Step ${s.n}`} title={s.t} text={s.d}>
            <Thumb slot="thumb" kind="text" value={String(s.n).padStart(2, '0')} />
          </Row>
        ))}
        <CtaCard inList />
      </ul>
    </section>

    <!-- ============ PRICING ============ -->
    <section class="section" id="pricing">
      <h2>Packages</h2>
      <p class="section-intro">
        Start with the free check. Everything after it is a fixed scope at a fixed price,
        agreed before any work starts.
      </p>
      <ul class="rows">
        {packages.map((p) => (
          <Row
            label={p.price === TBC ? `${p.note} · price ${TBC}` : `${p.price} · ${p.note}`}
            title={p.featured ? `${p.t} (most complete)` : p.t}
            text={p.d}
          >
            <Thumb slot="thumb" kind="text" value={p.price === TBC ? 'TBC' : p.price} sub={p.note.split(',')[0]} />
          </Row>
        ))}
      </ul>
    </section>

    <!-- ============ PRIVACY ============ -->
    <section class="section">
      <h2>Data and privacy</h2>
      <ul class="rows compact">
        {privacy.map((x) => <Row title={x.t} text={x.d} />)}
      </ul>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="section">
      <h2>FAQ</h2>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a} {f.href && <a href="#pricing">See the packages</a>}</p>
          </details>
        ))}
      </div>
    </section>

    <CtaCard heading="If your weekly reporting takes more than an hour, let's talk." button="Book a free 20-minute reporting check" />
  </div>
</BaseLayout>

<style>
  .fit { color: var(--faint); font-size: 14px; margin-top: 12px; }

  .table-wrap { margin-top: 30px; overflow-x: auto; }
  .kpis { width: 100%; border-collapse: collapse; }
  .kpis th, .kpis td { text-align: left; padding: 16px 14px 16px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .kpis thead th {
    font-family: var(--font-body); font-size: 12px; font-weight: 400; letter-spacing: 1px;
    text-transform: uppercase; color: var(--faint); border-top: 1px solid var(--line);
  }
  .kpis td:first-child { font-family: var(--font-display); font-weight: 700; color: var(--title); width: 52%; }
  .kpis td:last-child { color: var(--muted); }
  @media (max-width: 640px) {
    .kpis td { font-size: 14px; padding-block: 12px; }
  }
</style>
