---
import BaseLayout from '../layouts/BaseLayout.astro';

// The Streamlit app itself. Community Cloud can't take a custom domain, so the
// app is framed here instead — the visitor stays on hafsasaleh.tech.
// `embed=true` strips Streamlit's own chrome (menu, footer, deploy button).
const APP = 'https://dashboardportfolio-pkrvpygvmmvzp45egcfosx.streamlit.app';
const EMBED = `${APP}/?embed=true&embed_options=light_theme`;

const views = [
  'Executive summary',
  'Meta Ads',
  'Funnel & Pipeline',
  'Counsellors',
  'SEO & Traffic',
  'Forecast & Goals',
];
---

<BaseLayout
  title="Live Dashboard"
  description="The live Marketing Intelligence Dashboard — Meta Ads, GoHighLevel, GA4 and Search Console unified into one view, with attribution, funnel drop-off and forecasting."
>
  <section class="section" style="padding-bottom:1.5rem;">
    <div class="wrap">
      <p class="eyebrow">Live demo</p>
      <h1>Marketing Intelligence Dashboard</h1>
      <p class="lead" style="margin-top:1rem; max-width:44rem;">
        The real application, running live. Meta Ads, GoHighLevel, GA4 and Google Search
        Console unified into one source of truth — attribution, funnel drop-off,
        per-counsellor performance and a 30-day forecast.
      </p>

      <div class="tags" style="margin-top:1.4rem;">
        {views.map((v) => <span class="tag">{v}</span>)}
      </div>

      <div style="display:flex; gap:.75rem; flex-wrap:wrap; margin-top:1.8rem;">
        <a class="btn btn-ghost" href={APP} target="_blank" rel="noopener">Open full screen ↗</a>
        <a class="btn btn-ghost" href="/projects/marketing-intelligence-platform/">
          Read how it was built
        </a>
      </div>

      <p class="note">
        Hosted on Streamlit's free tier, so it sleeps when idle — the first load can take
        up to a minute to wake. If the frame below stays blank,
        <a href={APP} target="_blank" rel="noopener">open it directly</a>.
      </p>
    </div>
  </section>

  <section style="padding-bottom:4rem;">
    <div class="wrap">
      <div class="frame-shell">
        <iframe
          src={EMBED}
          title="Marketing Intelligence Dashboard"
          loading="lazy"
          allow="clipboard-write; fullscreen"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .note {
    margin-top: 1.4rem;
    font-size: 0.85rem;
    color: var(--muted);
    max-width: 44rem;
  }
  .note a { color: var(--accent); }

  .frame-shell {
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface-2);
    box-shadow: var(--shadow);
    /* tall enough for the app's own layout, capped so it never exceeds the viewport */
    height: min(82vh, 900px);
    min-height: 34rem;
  }
  .frame-shell iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
