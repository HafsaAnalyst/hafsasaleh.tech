---
import BaseLayout from '../layouts/BaseLayout.astro';
import SampleDashboard from '../components/SampleDashboard.astro';
import Row from '../components/Row.astro';
import Thumb from '../components/Thumb.astro';
import CtaCard from '../components/CtaCard.astro';
import { site } from '../site';
import { problems, builds, steps, proof, whyMe, faq, demoHref } from '../data/recruitment';
---

<BaseLayout
  fullTitle="Recruitment Agency Dashboards & Reporting Automation | Hafsa Saleh"
  description={site.description}
>
  <div class="index">
    <!-- ============ HEADER ============ -->
    <header class="index-header">
      <p class="eyebrow">Dashboards &amp; reporting automation for recruitment agencies</p>
      <h1>Know which recruiters, clients and candidates actually make you money.</h1>
      <p class="intro">
        Your ATS already holds the answers. I turn it into a live dashboard and an automated
        Monday report, so you stop rebuilding numbers in Excel.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href={site.booking} rel="noopener">Book a free 20-minute reporting check</a>
        <a class="text-link" href={demoHref}>See a sample dashboard →</a>
      </div>
    </header>

    <!-- ============ PROBLEMS ============ -->
    <section class="section">
      <h2>Sound familiar?</h2>
      <ul class="rows">
        {problems.map((p, i) => (
          <Row label={`Problem ${i + 1}`} title={p.t} text={p.d}>
            <Thumb slot="thumb" kind={p.thumb} />
          </Row>
        ))}
      </ul>
    </section>

    <!-- ============ WHAT I BUILD ============ -->
    <section class="section">
      <h2>What I build for recruitment agencies</h2>
      <p class="section-intro">
        A recruitment agency dashboard and the reporting around it, built from the data
        already in your ATS and spreadsheets.
      </p>
      <ul class="rows">
        {builds.map((b) => (
          <Row label="What you get" title={b.t} text={b.d} href="/recruitment-agencies/">
            <Thumb slot="thumb" kind={b.thumb} />
          </Row>
        ))}
        <CtaCard inList />
      </ul>
    </section>

    <!-- ============ SAMPLE DASHBOARD ============ -->
    <section class="section">
      <h2>A recruiter performance dashboard, at a glance</h2>
      <p class="section-intro">
        Billings, placements and pipeline conversion on one screen, refreshed without anyone
        exporting a thing.
      </p>
      <SampleDashboard />
    </section>

    <!-- ============ HOW IT WORKS ============ -->
    <section class="section">
      <h2>How it works</h2>
      <ul class="rows compact">
        {steps.map((s) => (
          <Row label={`Step ${s.n}`} title={s.t} text={s.d}>
            <Thumb slot="thumb" kind="text" value={String(s.n).padStart(2, '0')} />
          </Row>
        ))}
      </ul>
    </section>

    <!-- ============ PROOF ============ -->
    <section class="section">
      <h2>Results from other pipelines like yours</h2>
      <p class="section-intro">
        Measured results from a migration consultancy and a manufacturer, not from recruitment
        agencies. Same shape of problem: people or orders moving through stages, and reporting
        nobody trusted.
      </p>
      <ul class="rows">
        {proof.map((s) => (
          <Row label={s.from} title={s.label} href={s.href}>
            <Thumb slot="thumb" kind="text" value={s.big} />
          </Row>
        ))}
      </ul>
    </section>

    <!-- ============ WHY ME ============ -->
    <section class="section">
      <h2>Why me</h2>
      <ul class="rows compact">
        {whyMe.map((x) => <Row title={x.t} text={x.d} />)}
      </ul>
      <div class="actions">
        <a class="text-link" href="/about/">More about me →</a>
        <a class="text-link" href="/projects/show-rate-recovery/">Read a case study →</a>
      </div>
    </section>

    <!-- ============ FAQ ============ -->
    <section class="section">
      <h2>Questions owners ask</h2>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a} {f.href && <a href={f.href}>See the packages</a>}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- ============ FINAL CTA ============ -->
    <CtaCard heading="If your weekly reporting takes more than an hour, let's talk." button="Book a free 20-minute reporting check" />
  </div>
</BaseLayout>
