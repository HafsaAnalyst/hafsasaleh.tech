---
import BaseLayout from '../layouts/BaseLayout.astro';
import SampleDashboard from '../components/SampleDashboard.astro';
import { site } from '../site';
import { problems, builds, steps, proof, whyMe, faq, demoHref } from '../data/recruitment';

const BOOK = site.booking;
---

<BaseLayout
  fullTitle="Recruitment Agency Dashboards & Reporting Automation | Hafsa Saleh"
  description={site.description}
>

  <!-- ============ 1. HERO ============ -->
  <section class="hero">
    <div class="wrap hero-in">
      <p class="eyebrow">Dashboards &amp; reporting automation for recruitment agencies</p>

      <h1>Know which recruiters, clients and candidates actually make you money.</h1>
      <p class="deck">
        Your ATS already holds the answers. I turn it into a live dashboard and an automated
        Monday report, so you stop rebuilding numbers in Excel.
      </p>

      <div class="cta">
        <a class="btn primary" href={BOOK} rel="noopener">Book a free 20-minute reporting check</a>
        <a class="btn ghost" href={demoHref}>See a sample dashboard</a>
      </div>
    </div>
  </section>

  <!-- ============ 2. PROBLEMS ============ -->
  <section class="sec alt">
    <div class="wrap">
      <h2>Sound familiar?</h2>
      <div class="grid3">
        {problems.map((p) => (
          <article class="card">
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 3. WHAT I BUILD ============ -->
  <section class="sec">
    <div class="wrap">
      <h2>What I build for recruitment agencies</h2>
      <p class="sub">
        A recruitment agency dashboard and the reporting around it, built from the data
        already in your ATS and spreadsheets.
      </p>
      <div class="grid3">
        {builds.map((b) => (
          <a class="card" href="/recruitment-agencies/">
            <h3>{b.t}</h3>
            <p>{b.d}</p>
            <span class="more">How it works</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 4. SAMPLE DASHBOARD ============ -->
  <section class="sec alt">
    <div class="wrap">
      <h2>A recruiter performance dashboard, at a glance</h2>
      <p class="sub">
        Billings, placements and pipeline conversion on one screen, refreshed without
        anyone exporting a thing.
      </p>
      <SampleDashboard />
    </div>
  </section>

  <!-- ============ 5. HOW IT WORKS ============ -->
  <section class="sec">
    <div class="wrap">
      <h2>How it works</h2>
      <ol class="steps">
        {steps.map((s) => (
          <li>
            <span class="step-n">{s.n}</span>
            <div>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ 6. PROOF ============ -->
  <section class="sec alt">
    <div class="wrap">
      <h2>Results from other pipelines like yours</h2>
      <p class="sub">
        Measured results from a migration consultancy and a manufacturer, not from recruitment
        agencies. Same shape of problem: people or orders moving through stages, and reporting
        nobody trusted. Each links to how it was done.
      </p>
      <div class="proof">
        {proof.map((s) => (
          <a class="pstat" href={s.href}>
            {/* Rendered as the final value, so it is correct with or without JS.
                The count-up only ever animates from 0 up to what is already here. */}
            <span class="pbig" data-count={s.big}>{s.big}</span>
            <span class="plab">{s.label}</span>
            <span class="pfrom">{s.from}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 7. WHY ME ============ -->
  <section class="sec">
    <div class="wrap">
      <h2>Why me</h2>
      <dl class="delivered">
        {whyMe.map((x) => (
          <div>
            <dt>{x.t}</dt>
            <dd>{x.d}</dd>
          </div>
        ))}
      </dl>
      <p class="cta-line">
        <a class="btn ghost" href="/about/">More about me</a>
        <a class="btn ghost" href="/projects/">See the case studies</a>
      </p>
    </div>
  </section>

  <!-- ============ 8. FAQ ============ -->
  <section class="sec alt">
    <div class="wrap">
      <h2>Questions owners ask</h2>
      <div class="faq">
        {faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a} {f.href && <a href={f.href}>See the packages</a>}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ 9. FINAL CTA ============ -->
  <section class="sec final">
    <div class="wrap">
      <h2>If your weekly reporting takes more than an hour, let&rsquo;s talk.</h2>
      <p class="sub center">
        Twenty minutes on how you report today. You leave knowing where your numbers are
        weakest, whether or not you work with me afterwards.
      </p>
      <p class="cta-line center">
        <a class="btn primary big" href={BOOK} rel="noopener">Book a free 20-minute reporting check</a>
      </p>
      <p class="micro">No pitch deck, no obligation. If I can't help, I'll say so on the call.</p>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- shared ---------- */
  .wrap { width: 100%; max-width: 66rem; margin-inline: auto; padding-inline: 1.5rem; }
  .sec { padding-block: clamp(4rem, 9vw, 7rem); }
  .sec.alt { background: var(--surface-2); }
  h1 { font-size: clamp(2.1rem, 5.2vw, 3.6rem); font-weight: 800; letter-spacing: -.035em; line-height: 1.08; max-width: 20ch; }
  h2 { font-size: clamp(1.6rem, 3.4vw, 2.3rem); font-weight: 800; letter-spacing: -.03em; }
  h3 { font-size: 1.05rem; font-weight: 700; letter-spacing: -.015em; }
  .sub { color: var(--muted); margin-top: .7rem; max-width: 46rem; }
  .sub.center, .center { text-align: center; margin-inline: auto; }

  .cta { display: flex; gap: .7rem; flex-wrap: wrap; margin-top: 2rem; }
  .cta-line { display: flex; gap: .7rem; flex-wrap: wrap; margin-top: 2.2rem; }
  .btn { border-radius: 8px; }
  .btn.primary { background: var(--accent); color: var(--paper); font-weight: 600; padding: .8rem 1.5rem; }
  .btn.primary:hover { background: var(--accent-2); }
  .btn.ghost { border: 1px solid var(--line); color: var(--ink); padding: .8rem 1.4rem; }
  .btn.ghost:hover { border-color: var(--accent); color: var(--accent); }
  .btn.big { padding: 1rem 2rem; font-size: 1.02rem; }

  .card {
    background: var(--surface); border: 0;
    border-radius: 10px; padding: 1.6rem;
    display: flex; flex-direction: column; gap: .5rem;
  }
  a.card { text-decoration: none; color: inherit; transition: background .18s; }
  a.card:hover { background: var(--surface-2); }
  .sec.alt a.card:hover { background: var(--paper); }
  .card p { color: var(--muted); font-size: .92rem; }
  .grid3 { display: grid; gap: 1rem; margin-top: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr)); }
  .more { margin-top: auto; padding-top: .6rem; color: var(--accent); font-weight: 600; font-size: .88rem; }

  /* ---------- 1. hero ---------- */
  /* No gradient, no glow, no entrance animation. The restraint is the design. */
  .hero { padding-block: clamp(4rem, 10vw, 7rem) clamp(3.5rem, 8vw, 5.5rem); }
  .hero .eyebrow { margin-bottom: 1.2rem; }
  .deck { font-size: clamp(1rem, 1.7vw, 1.16rem); color: var(--ink-2); margin-top: 1.1rem; max-width: 44rem; line-height: 1.65; }

  /* ---------- 5. steps ---------- */
  .steps { list-style: none; padding: 0; margin-top: 2rem; display: grid; gap: 1.2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 11.5rem), 1fr)); }
  .steps li { display: flex; gap: .9rem; align-items: flex-start; }
  .step-n {
    flex: none; width: 1.9rem; height: 1.9rem; border-radius: 50%;
    display: grid; place-items: center; font-size: .82rem; font-weight: 700;
    color: var(--accent); border: 1px solid var(--accent);
  }
  .steps h3 { font-size: 1rem; }
  .steps p { color: var(--muted); font-size: .88rem; margin-top: .3rem; }

  /* ---------- 6. proof ---------- */
  .proof { display: grid; gap: 1rem; margin-top: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .pstat {
    text-decoration: none; color: inherit; padding: 1.6rem 0;
    border-top: 1px solid var(--line);
    display: flex; flex-direction: column; gap: .4rem; transition: opacity .18s;
  }
  .pstat:hover { opacity: .72; }
  .pbig { font-size: clamp(1.5rem, 3vw, 1.95rem); font-weight: 800; letter-spacing: -.035em; color: var(--accent); font-variant-numeric: tabular-nums; }
  .plab { font-size: .84rem; color: var(--ink-2); line-height: 1.45; }
  .pfrom { font-family: var(--font-mono); font-size: .7rem; color: var(--muted); letter-spacing: .02em; }

  /* ---------- 7. why me ---------- */
  .delivered { margin-top: 2.4rem; }
  .delivered > div {
    display: grid; grid-template-columns: 15rem 1fr; gap: 2rem;
    padding-block: 1.5rem; border-top: 1px solid var(--line);
  }
  .delivered > div:last-child { border-bottom: 1px solid var(--line); }
  .delivered dt { font-weight: 700; font-size: 1rem; }
  .delivered dd { margin: 0; color: var(--muted); font-size: .94rem; line-height: 1.7; }
  @media (max-width: 46rem) {
    .delivered > div { grid-template-columns: 1fr; gap: .4rem; }
  }

  /* ---------- 8. faq ---------- */
  .faq { margin-top: 2rem; border-top: 1px solid var(--line); max-width: 48rem; }
  .faq details { border-bottom: 1px solid var(--line); }
  .faq summary {
    cursor: pointer; list-style: none; padding: 1.1rem 2rem 1.1rem 0; position: relative;
    font-weight: 600;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after {
    content: '+'; position: absolute; right: .2rem; top: 50%; transform: translateY(-50%);
    color: var(--accent); font-size: 1.3rem; font-weight: 400;
  }
  .faq details[open] summary::after { content: '−'; }
  .faq p { color: var(--muted); font-size: .94rem; padding-bottom: 1.2rem; max-width: 42rem; }
  .faq a { color: var(--accent); font-weight: 600; }

  /* ---------- 9. final ---------- */
  .final { text-align: center; }
  .final h2 { max-width: 30ch; margin-inline: auto; }
  .final .cta-line { justify-content: center; }
  .micro { font-size: .82rem; color: var(--muted); margin-top: 1rem; }
</style>

<script>
  // Count-up on the proof stats.
  // The final value is already in the HTML, so if this never runs (no JS, no
  // IntersectionObserver, reduced motion) the correct number is what shows.
  // Nothing here can leave a 0 on screen.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    const animate = (el: HTMLElement) => {
      const final = el.dataset.count ?? el.textContent ?? '';
      // Animate only the numeric runs, leaving arrows, %, $ and words in place.
      const parts = final.split(/(\d[\d,.]*)/);
      const nums = parts.map((p) => (/^\d/.test(p) ? parseFloat(p.replace(/,/g, '')) : null));
      if (!nums.some((n) => n !== null)) return;

      const dur = 900;
      const t0 = performance.now();
      const step = (now: number) => {
        const prog = Math.min(1, (now - t0) / dur);
        const eased = 1 - Math.pow(1 - prog, 3);
        el.textContent = parts
          .map((p, i) => {
            const n = nums[i];
            if (n === null) return p;
            const v = n * eased;
            const dec = p.includes('.') ? 1 : 0;
            return (dec ? v.toFixed(1) : Math.round(v).toLocaleString('en-US'));
          })
          .join('');
        if (prog < 1) requestAnimationFrame(step);
        else el.textContent = final; // always land exactly on the real value
      };
      requestAnimationFrame(step);
    };

    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        io.unobserve(en.target);
        animate(en.target as HTMLElement);
      });
    }, { threshold: 0.6 });

    document.querySelectorAll<HTMLElement>('.pbig').forEach((el) => io.observe(el));
  }
</script>
